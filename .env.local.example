NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Supabase Keep-Alive cron (/api/cron/supabase-keepalive) ---
# Secret used to authorize the Vercel Cron request (Authorization: Bearer <CRON_SECRET>).
CRON_SECRET=replace-with-a-long-random-secret
# JSON array of the Supabase projects to ping. Use anon keys only — never service_role.
SUPABASE_KEEPALIVE_PROJECTS=[{"name":"project-name","url":"https://PROJECT_REF.supabase.co","anonKey":"SUPABASE_ANON_KEY"}]

# --- Phone task creation via Yemot Hamashiach (/api/ivr/yemot) ---
# Shared secret the Yemot "API" extension must send as a `token` param.
# REQUIRED (fail-closed): if unset, the endpoint refuses every request with 503.
YEMOT_IVR_TOKEN=replace-with-a-long-random-secret
# Server-side Supabase access for the IVR route (falls back to NEXT_PUBLIC_* if unset).
# Anon key only — never service_role.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
